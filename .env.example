# Supabase 프로젝트 설정 > API 메뉴에서 확인
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 관리자 대시보드 로그인 비밀번호 (직접 정해서 입력)
ADMIN_PASSWORD=change-me

# 관리자 로그인 쿠키 서명에 쓰는 임의의 긴 문자열 (직접 아무 값이나 길게 입력)
COOKIE_SECRET=change-me-too-please-make-this-long-and-random

# AI 튜터 (선택)
ANTHROPIC_API_KEY=
# TUTOR_MODEL=claude-haiku-4-5-20251001
# GEMINI_API_KEY=   (무료 사용량 있음. 있으면 Gemini를 우선 사용)
